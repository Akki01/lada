prefix=C:/lada/build_gtk_release/gtk/x64/release
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Adwaita
Description: Building blocks for modern GNOME applications
Version: 1.8.3
Requires: gtk4 >=  4.19.4
Requires.private: glib-2.0 >=  2.80.0, fribidi, gio-2.0 >=  2.80.0, gtk4-win32 >=  4.19.4
Libs: -L${libdir} -ladwaita-1
Cflags: -I${includedir}/libadwaita-1
